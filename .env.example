# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS. NEVER prefix this with NEXT_PUBLIC_, never commit
# it, and never reference it from a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Email — resend.com
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key

# Must be a domain verified in Resend. The default below works only for sending
# to the address that owns the Resend account — fine for a dry run, not for the
# event itself.
EMAIL_FROM=Web Development Workshop <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to build the Google OAuth redirect. Must match the deployed origin
# exactly, with no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — dashboard → Settings → API
# ---------------------------------------------------------------------------
# "Project URL" — the FIRST item in the dashboard's Copy menu. Not a key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Bypasses RLS. NEVER prefix this with NEXT_PUBLIC_, never commit
# it, and never reference it from a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Certificate email — Google Apps Script
# ---------------------------------------------------------------------------
# Deploy scripts/apps-script/Code.gs as a Web App (Execute as: Me,
# Who has access: Anyone), then paste the /exec URL here.
#
# Quota: consumer @gmail.com sends 100 recipients/day, Google Workspace 1,500.
# Open the /exec URL in a browser to see what is left today.
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Must match SHARED_SECRET inside Code.gs. The web app is public, so this is
# the only thing protecting your send quota — make it long and random.
APPS_SCRIPT_SECRET=generate-a-long-random-string

# Display name students see in their inbox.
EMAIL_FROM_NAME=Web Development Workshop

# Optional: where student replies should go.
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to build the Google OAuth redirect. Must match the deployed origin
# exactly, with no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
